# Copy this file to .env and fill in real values for your environment.
# All variables mirror fields on the Settings class in app/core/config.py
# (pydantic-settings reads them from this file or from real process env vars,
# matched case-insensitively against the uppercased field name).

# --- General ----------------------------------------------------------------
APP_NAME="Impala Lineage Service"
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# SQLAlchemy connection string for the metadata/lineage store.
# When running via docker-compose, this is overridden to point at the
# `postgres` service hostname regardless of what's set here - see
# docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://lineage:lineage@localhost:5432/lineage

# --- Security -----------------------------------------------------------
# Used to derive the Fernet key that encrypts stored connection credentials.
# Generate a real secret before deploying, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-byte-string

# If set, all API requests must send this value in the X-API-Key header.
# Leave blank to disable API key enforcement.
API_KEY=

# JSON array of allowed CORS origins for the frontend.
CORS_ORIGINS=["http://localhost:5173"]

# --- AI-assisted lineage fallback -----------------------------------------
# When sqlglot cannot confidently resolve lineage, the service can fall back
# to an AI-assisted pass using the Anthropic API. Leave ANTHROPIC_API_KEY
# blank to disable this entirely (the fallback is skipped, not an error).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_LINEAGE_FALLBACK_ENABLED=true

# --- Scanning behavior ----------------------------------------------------
DEFAULT_QUERY_TIMEOUT_SECONDS=120
SCAN_MAX_CONCURRENT_OBJECTS=8

# --- scripts/seed_connections.py -------------------------------------------
# Optional: only read by `python scripts/seed_connections.py`, not by the app
# itself. Registers one Impala target as a Connection row so you don't have
# to add it by hand through the API/UI. Leave unset to skip seeding.
IMPALA_CONNECTION_NAME=impala-primary
IMPALA_HOST=
IMPALA_PORT=21050
IMPALA_USER=
IMPALA_PASS=
IMPALA_DEFAULT_DATABASE=default
IMPALA_AUTH_MECHANISM=LDAP
IMPALA_USE_SSL=false
