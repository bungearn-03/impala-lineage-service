# --- Build stage -----------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
# No package-lock.json is committed yet (never generated by an `npm install`
# run), so `npm ci` (which requires one) can't be used here. `npm install`
# resolves and installs from package.json directly instead.
RUN npm install

COPY . .

# Build-time API config: bake VITE_* vars into the static bundle.
# Override at build time, e.g.:
#   docker build --build-arg VITE_API_BASE_URL=https://lineage.example.com/api/v1 .
ARG VITE_API_BASE_URL=http://localhost:8000/api/v1
ARG VITE_API_KEY=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_KEY=${VITE_API_KEY}

RUN npm run build

# --- Runtime stage -----------------------------------------------------------
FROM nginx:alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
